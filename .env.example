# Copy this file to .env.local for local dev.
# In Vercel, set these under Project Settings → Environment Variables instead
# of a committed file — see README "Deploy steps".

# Neon connection string (Dashboard → Connection Details → Pooled connection)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk (Dashboard → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
